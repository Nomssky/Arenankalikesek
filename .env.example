# Monorepo Arenan Kalikesek — contoh environment variable
#
# Setiap aplikasi punya file .env.example sendiri:
#   - apps/frontend/.env.example  (variabel browser-safe NEXT_PUBLIC_*)
#   - apps/backend/.env.example   (secret: service key, server key, ADMIN_PASSWORD)
#
# Nilai asli TIDAK pernah di-commit. Salin ke apps/<app>/.env.local.

# Frontend (apps/frontend/.env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_API_URL=
NEXT_PUBLIC_SITE_URL=

# Backend (apps/backend/.env.local)
SUPABASE_SERVICE_ROLE_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_API_URL=
ADMIN_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=noreply@arenankalikesek.com
