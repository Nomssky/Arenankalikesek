# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Midtrans (Payment Gateway)
# Snap popup: client key for frontend, server key for backend
# NEXT_PUBLIC_MIDTRANS_API_URL for Snap.js CDN; MIDTRANS_API_URL for server-side API calls
# Sandbox: https://app.sandbox.midtrans.com
# Production: https://app.midtrans.com
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_midtrans_client_key
NEXT_PUBLIC_MIDTRANS_API_URL=https://app.midtrans.com
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_API_URL=https://app.midtrans.com

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Panel
ADMIN_PASSWORD=your_admin_password
