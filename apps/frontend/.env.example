# Environment variable untuk frontend (browser-safe, prefix NEXT_PUBLIC_)
# Salin file ini menjadi .env.local di apps/frontend/

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Midtrans Snap (popup pembayaran di browser)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_midtrans_client_key
NEXT_PUBLIC_MIDTRANS_API_URL=https://app.sandbox.midtrans.com

# URL situs (untuk metadata + redirect pembayaran)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CATATAN: karena frontend dan backend di-deploy dalam satu project,
# secret backend (SUPABASE_SERVICE_ROLE_KEY, MIDTRANS_SERVER_KEY,
# ADMIN_PASSWORD) juga wajib ada di apps/frontend/.env.local agar API
# berfungsi. Lihat apps/backend/.env.example untuk daftar lengkapnya.
