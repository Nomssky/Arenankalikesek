# Environment variable untuk backend (hanya dijalankan di server, TIDAK boleh bocor ke browser)
# Salin file ini menjadi .env.local di apps/backend/

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Midtrans
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_API_URL=https://app.sandbox.midtrans.com
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_midtrans_client_key

# URL frontend (untuk redirect pembayaran kembali ke situs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel (secret — digunakan untuk HMAC session token)
ADMIN_PASSWORD=your_admin_password

# Email notif (Resend, gratis 3.000/bln) — wajib verifikasi domain arenankalikesek.com
# di https://resend.com lalu isi API key. Default EMAIL_FROM=noreply@arenankalikesek.com.
# Toggle aktif/non-aktif di admin: Pengaturan Booking → Notifikasi Email (checkbox).
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@arenankalikesek.com

# Sinkronisasi jadwal dari Google Sheets (docs/rencana-sync-spreadsheet.md).
# Secret untuk cron eksternal memanggil POST /api/cron/sync-jadwal (header X-Sync-Secret).
JADWAL_SYNC_SECRET=your_random_long_secret
# ID spreadsheet (opsional — default sudah mengarah ke sheet resmi jadwal):
# JADWAL_SHEET_ID=1gzr2YDHUvJf-dy4lzzsH_jM4NcPbmCAmKRGzFG7tG_I
# PENGINAPAN_SHEET_ID=1s6OGNLru3a6TpP7CtbgO4qR6wwdswl-hCylH1r2W7UQ
